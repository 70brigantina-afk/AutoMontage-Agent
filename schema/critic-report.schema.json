{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automontage.local/schema/critic-report.schema.json",
  "title": "AutoMontage Critic Report",
  "description": "Входной отчёт критика. Сохранённый qa/critic-NN.json - обёртка {report, decision}: round в ней пересчитывает команда automontage critic по цепочке кругов, поэтому в сохранённом отчёте он может отличаться от входного.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "round", "previewSha256", "scenes", "summary"],
  "properties": {
    "version": { "const": 1 },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "previewSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scene" }
    },
    "summary": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "score": { "type": "integer", "minimum": 1, "maximum": 10 },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fromSec", "toSec", "scores", "issues"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fromSec": { "type": "number", "minimum": 0 },
        "toSec": { "type": "number", "exclusiveMinimum": 0 },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idea", "composition", "motion", "typography", "rhythm"],
          "properties": {
            "idea": { "$ref": "#/definitions/score" },
            "composition": { "$ref": "#/definitions/score" },
            "motion": { "$ref": "#/definitions/score" },
            "typography": { "$ref": "#/definitions/score" },
            "rhythm": { "$ref": "#/definitions/score" }
          }
        },
        "issues": {
          "description": "У сцены с оценкой ниже 9 нужна минимум одна правка (проверяет scripts/qa/critic.js).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "fix"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "fix": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
